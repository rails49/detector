{
  "name": "@rails49/detector",
  "version": "0.0.1",
  "description": "The rails49 occupancy detector: its browser runtime, car geometry and, once one is measured, the model",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rails49/detector.git",
    "directory": "lib/detector"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./model": "./dist/detector_int8.ort"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-model.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rails49/r49": "catalog:",
    "onnxruntime-common": "^1.26.0"
  },
  "peerDependencies": {
    "onnxruntime-web": "^1.26.0"
  },
  "devDependencies": {
    "onnxruntime-web": "^1.26.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
